<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LegalAssistantToolPuppet</RootNamespace>
  </PropertyGroup>

  <!-- The puppet run needs the real tool set: the legal tool under test and the tool that turns
       markdown into a DOCX (WordTool's DocumentTool). Both are sibling repositories; when one is
       absent the project does not build, and it is never part of the plugin. -->
  <ItemGroup>
    <ProjectReference Include="..\LegalAssistantTool.csproj" />
    <ProjectReference Include="..\..\AIOrchestrator\AIOrchestrator.csproj" Condition="Exists('..\..\AIOrchestrator\AIOrchestrator.csproj')" />
    <ProjectReference Include="..\..\WordTool\DocumentTool.csproj" Condition="Exists('..\..\WordTool\DocumentTool.csproj')" />
  </ItemGroup>

</Project>
